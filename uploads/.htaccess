# Public uploads are images and media only: never run scripts from this folder.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|html?|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
